{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "seraphine-music",
  "version": "0.1.13",
  "identifier": "com.tauri.seraphine-music",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "desktop-lyric",
        "title": "桌面歌词",
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true
      },
      {
        "label": "mini-player",
        "title": "迷你播放器",
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "main-capability",
        "desktop-lyric-capability",
        "mini-player-capability"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http: https:; connect-src 'self' http: https:;style-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "bunre_lee",
    "copyright": "Copyright \u00a9 2026 bunre_lee",
    "category": "Music",
    "shortDescription": "Seraphine \u97f3\u4e50\u64ad\u653e\u5668",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": false,
      "entitlements": "entitlements/entitlements.plist"
    }
  },
  "plugins": {}
}
